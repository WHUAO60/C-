<!-- MainWindow.xaml -->
<Window x:Class="NewsAggregator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NewsAggregator.Converters"
        Title="📰 资讯聚合器" Height="650" Width="1100"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToFavoriteStarConverter x:Key="BoolToStarConverter"/>
        <converters:ReadCountToColorConverter x:Key="ReadCountColorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Margin="0,0,0,15" Padding="0,0,0,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📰" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="资讯聚合器" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="❓ 帮助" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Cursor="Hand" MouseLeftButtonDown="BtnHelp_Click"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="📡 管理订阅" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                               Cursor="Hand" MouseLeftButtonDown="BtnManageSources_Click"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索框 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="12,10"/>
                <TextBlock IsHitTestVisible="False" Text="🔍 输入关键词搜索文章标题、摘要或来源..."
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="清除" Width="70"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="10,0,0,0" Click="BtnClearSearch_Click"/>
        </Grid>

        <!-- 模式切换 + 网络搜索 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10">
            <Button x:Name="BtnRssMode" Content="📡 订阅模式" Width="110"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnRssMode_Click"/>
            <Button x:Name="BtnSearchMode" Content="🔍 搜索模式" Width="110"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Click="BtnSearchMode_Click"/>
            <TextBox x:Name="TxtSearchKeyword" Width="200"
                     Style="{StaticResource ModernTextBoxStyle}" Margin="16,0,8,0"
                     Visibility="Collapsed" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnSearchWeb" Content="🔍 搜索网络" Width="100"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnSearchWeb_Click"
                    Visibility="Collapsed"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnRefresh" Content="🔄 刷新文章"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnFavorite" Content="⭐ 收藏/取消"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Click="BtnFavorite_Click"/>
            <Button x:Name="BtnExportOne" Content="📄 导出选中"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Click="BtnExportOne_Click"/>
            <Button x:Name="BtnExportAll" Content="📦 导出全部"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    Click="BtnExportAll_Click"/>
        </StackPanel>

        <!-- 筛选栏 -->
        <Border Grid.Row="4" Margin="0,0,0,12" Padding="12,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="最低阅读量：" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <TextBox x:Name="TxtMinReadCount" Width="100"
                         Text="{Binding MinReadCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnClearFilter" Content="清除筛选"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                        Click="BtnClearFilter_Click"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="20,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 列表 -->
        <ListView Grid.Row="5" ItemsSource="{Binding Articles}"
                  SelectedItem="{Binding SelectedArticle}"
                  Style="{StaticResource ModernListViewStyle}"
                  SelectionMode="Single"
                  MouseDoubleClick="ArticleListView_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                                    <GridViewRowPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="⭐" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BoolToStarConverter}}"
                                           HorizontalAlignment="Center" FontSize="16"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="标题" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="来源" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source}" FontSize="11"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="时间" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FetchTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="阅读量" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding ReadCount, Converter={StaticResource ReadCountColorConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding ReadCount, StringFormat='{}{0:N0}'}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="摘要" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 空状态 -->
        <TextBlock Grid.Row="5" Text="📭 还没有文章，点击「🔄 刷新文章」或切换到「🔍 搜索模式」开始吧！"
                   FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Articles.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 状态栏 -->
        <Border Grid.Row="6" Margin="0,12,0,0" Padding="12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>